{
  "name": "@oneworks/avatar",
  "version": "1.0.0-rc.7",
  "description": "Framework-neutral OneWorks 3D Avatar definitions, catalog, and animation runtime",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
