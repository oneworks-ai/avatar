{
  "name": "@oneworks/avatar-react",
  "version": "1.0.0-rc.9",
  "description": "React renderer and embeddable editor for OneWorks 3D Avatar",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "./dist/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/oneworks-ai/avatar.git",
    "directory": "packages/react"
  },
  "exports": {
    ".": {
      "__oneworks__": "./src/index.tsx",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": {
      "__oneworks__": "./src/style.scss",
      "default": "./dist/style.css"
    },
    "./package.json": "./package.json",
    "./renderer": {
      "__oneworks__": "./src/renderer.tsx",
      "types": "./dist/renderer.d.ts",
      "default": "./dist/renderer.js"
    },
    "./renderer.css": {
      "__oneworks__": "./src/renderer-style.scss",
      "default": "./dist/renderer.css"
    },
    "./editor": {
      "__oneworks__": "./src/editor.tsx",
      "types": "./dist/editor.d.ts",
      "default": "./dist/editor.js"
    },
    "./editor.css": {
      "__oneworks__": "./src/style.scss",
      "default": "./dist/editor.css"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-Hans.md"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@oneworks/avatar": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20",
    "react-dom": ">=18.3.0 <20"
  },
  "publishConfig": {
    "access": "public"
  }
}
