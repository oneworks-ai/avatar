    "showOutline": true,
    "avatarOutlineStyle": {
      "color": "#1b1026",
      "width": 14,
      "opacity": 96
    },
    "pixelEffect": {
      "enabled": true,
      "blockSize": 6,
      "paletteSize": 16,
      "sampling": "slic",
      "dithering": "none"
    },
    "showFrameShadow": true,
    "frameShadowStyle": {
      "direction": 90,
      "distance": 12,
      "opacity": 20,
      "softness": 24
    }
