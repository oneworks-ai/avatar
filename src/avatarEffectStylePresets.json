{
  "chunky-pixel": {
    "label": "Chunky Pixel",
    "samples": [
      "cat",
      "dog",
      "fox",
      "owl",
      "penguin",
      "sheep",
      "bear",
      "rabbit",
      "capybara",
      "cow",
      "tiger",
      "parrot"
    ],
    "cameraBackground": "#8ea2b8",
    "cameraFrame": "rounded",
    "cameraMode": true,
    "showLight": true,
    "lightAzimuth": -35,
    "lightElevation": 40,
    "lightDistance": 0,
